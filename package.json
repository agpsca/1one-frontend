{
  "name": "1one-frontend",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "check:ci": "biome check . --error-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "check:tokens": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mts",
    "check:modal": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-modal-store.mts",
    "check:nav": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-nav.mts",
    "check:proxy": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-proxy.mts",
    "check:logo": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-brand-logo.mts",
    "check:login": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-login-transition.mts",
    "verify": "pnpm check:ci && pnpm typecheck && pnpm check:tokens && pnpm check:modal && pnpm check:nav && pnpm check:proxy && pnpm check:logo && pnpm check:login",
    "api:pull": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/pull-openapi.mts",
    "api:gen": "orval",
    "api:sync": "pnpm api:pull && pnpm api:gen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,json,css}": [
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "{src/app/globals.css,src/lib/tokens.ts}": [
      "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mts"
    ],
    "src/stores/modal-store.ts": [
      "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-modal-store.mts"
    ],
    "src/lib/http/upstream.ts": [
      "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-proxy.mts"
    ],
    "src/lib/nav.ts": [
      "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-nav.mts"
    ],
    "src/features/auth/login-form.tsx": [
      "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-login-transition.mts"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "orval": "8.43.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

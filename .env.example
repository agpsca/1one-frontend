# Backend consumido pelo proxy em `app/api/[...path]`. Server-only de
# proposito: sem o prefixo NEXT_PUBLIC_, o endereco nao vai pro bundle e o
# browser fala apenas com a mesma origem — nao ha CORS pra configurar.
BACKEND_URL=http://localhost:8000

# Escotilha de desenvolvimento. Com um valor aqui, o proxy usa este token
# quando nao existe cookie de sessao: da pra navegar e chamar a API sem passar
# pelo login. Ignorada quando NODE_ENV=production. Deixe vazia se nao precisar.
AUTH_BYPASS_TOKEN=

# Usado apenas pelo script `pnpm api:pull` (nunca vai pro bundle).
OPENAPI_URL=http://localhost:8000/openapi.json

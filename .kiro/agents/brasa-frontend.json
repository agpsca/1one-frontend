{
  "name": "brasa-frontend",
  "description": "Implementa e autorrevisa mudanças frontend estritamente simples, escalando o restante para Lava.",
  "prompt": "file://../../.agents/skills/1one-frontend-team/references/brasa-frontend.md",
  "tools": ["code", "glob", "grep", "read", "shell", "subagent/lava", "write"],
  "allowedTools": ["fs_read", "grep", "glob", "code"],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": ["src/**", "scripts/**"],
      "deniedPaths": [".env*", ".git/**", "pnpm-lock.yaml"]
    },
    "execute_bash": {
      "allowedCommands": [
        "^git status --short --untracked-files=all$",
        "^git diff$",
        "^git diff --cached$",
        "^git diff --check$",
        "^git diff --cached --check$",
        "^pnpm (?:verify|check|check:ci|typecheck|check:tokens|check:modal|check:nav|check:proxy|check:logo|check:login|check:logout|check:agents)$",
        "^pnpm exec biome check(?: --(?:error-on-warnings|write|no-errors-on-unmatched))*(?: (?:[A-Za-z0-9_./@:+-]+|'[A-Za-z0-9_./()@:+ -]+'))+$",
        "^node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-[A-Za-z0-9_-]+\\.mts$"
      ],
      "deniedCommands": [
        "[;&|><`$]",
        "(?:^|[;&|])\\s*(?:rm|sudo|git push|git commit)\\b"
      ],
      "denyByDefault": true,
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": ["lava"],
      "trustedAgents": ["lava"]
    }
  },
  "resources": [
    "file://../../README.md",
    "file://../../package.json",
    "file://../../components.json",
    "file://../../biome.json",
    "file://../../tsconfig.json",
    "file://../../.agents/skills/1one-frontend-team/SKILL.md",
    "file://../../.agents/skills/1one-frontend-team/references/learnings.md",
    "file://../../.agents/skills/1one-frontend-team/references/rubric.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git status --short --untracked-files=all",
          "git diff",
          "git diff --cached",
          "git diff --check",
          "git diff --cached --check",
          "pnpm verify",
          "pnpm check",
          "pnpm check:ci",
          "pnpm typecheck",
          "pnpm check:tokens",
          "pnpm check:modal",
          "pnpm check:nav",
          "pnpm check:proxy",
          "pnpm check:logo",
          "pnpm check:login",
          "pnpm check:logout",
          "pnpm check:agents",
          "pnpm exec biome check *",
          "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-*.mts"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*;*",
          "*&*",
          "*|*",
          "*>*",
          "*<*",
          "*`*",
          "*$*",
          "*--output*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": ["*"],
        "exclude": [
          "git diff",
          "git diff --cached",
          "git diff --cached --check",
          "git diff --check",
          "git status --short --untracked-files=all",
          "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-*.mts",
          "pnpm check",
          "pnpm check:agents",
          "pnpm check:ci",
          "pnpm check:login",
          "pnpm check:logo",
          "pnpm check:logout",
          "pnpm check:modal",
          "pnpm check:nav",
          "pnpm check:proxy",
          "pnpm check:tokens",
          "pnpm exec biome check",
          "pnpm exec biome check *",
          "pnpm typecheck",
          "pnpm verify"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": ["src/**", "scripts/**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [".env*", ".git/**", "pnpm-lock.yaml"],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": ["lava"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      }
    ]
  }
}
